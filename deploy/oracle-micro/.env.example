# On the server:  cd ~/pantea/stack && cp -n .env.example .env && nano .env
# .env is never uploaded or committed. Each machine has its own.

# This machine's name. Its DNS A record must point at this machine's public IP before the first start,
# otherwise Caddy cannot get a certificate.
#   receipts machine:  receipts.panteadesignstudio.com
#   match machine:     match.panteadesignstudio.com
DOMAIN=receipts.panteadesignstudio.com

# Let's Encrypt uses this only for expiry warnings.
ACME_EMAIL=you@example.com

# Shared secret with WordPress for this service. Generate with:  openssl rand -base64 32
API_KEY=replace-me

# Requests allowed per client IP per minute.
RATE_LIMIT=20

# On the server:  cd ~/pantea/stack && cp .env.example .env && nano .env
# .env is never uploaded or committed.

# Both names must have a DNS A record pointing at this machine's public IP before the first start,
# otherwise Caddy cannot get certificates.
MATCH_DOMAIN=match.panteadesignstudio.com
RECEIPTS_DOMAIN=receipts.panteadesignstudio.com

# Let's Encrypt uses this only for expiry warnings.
ACME_EMAIL=you@example.com

# Shared secrets with WordPress, one per service. Generate each with:  openssl rand -base64 32
MATCHER_API_KEY=replace-me
GATE_API_KEY=replace-me-too

# Requests allowed per client IP per minute.
MATCHER_RATE_LIMIT=20
GATE_RATE_LIMIT=20

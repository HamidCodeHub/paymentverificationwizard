# Copy to .env on the server:  cp .env.example .env  &&  nano .env
# .env is gitignored. Never commit the real one.

# Subdomain pointing at this server's public IP; the DNS A record must resolve before you start the stack.
DOMAIN=receipts.yourdomain.com

# Let's Encrypt uses this only for expiry warnings.
ACME_EMAIL=you@yourdomain.com

# Shared secret between WordPress and this service. Generate one with:  openssl rand -base64 32
GATE_API_KEY=replace-me

# Checks allowed per client IP per minute (WordPress should forward the customer's IP as X-Forwarded-For).
GATE_RATE_LIMIT=20
